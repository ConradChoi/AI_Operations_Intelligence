NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Same values as above, under non-reserved names so
# `supabase functions serve --env-file` doesn't override them
# with the local dev stack.
PROJECT_URL=
PROJECT_SERVICE_ROLE_KEY=

# The run-spend-analysis function is only servable locally (`supabase functions
# serve`), not deployed to the hosted project, so scripts/seed-demo.ts must call
# the local dev gateway rather than `${NEXT_PUBLIC_SUPABASE_URL}/functions/v1`.
SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1

# Canonical public origin — required on hosts (e.g. AWS Amplify) where the
# request's own Host header doesn't reflect the public domain. See
# src/lib/getOrigin.ts.
NEXT_PUBLIC_SITE_URL=

# Optional: an account that skips onboarding and lands on /demo/spend/overview
# right after login/signup, for handing to sales prospects. See
# src/lib/postLoginRedirect.ts.
NEXT_PUBLIC_DEMO_ACCOUNT_EMAIL=
